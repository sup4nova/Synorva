# ── Clés API (collecte de données) ──────────────────────────────
# Unsplash — https://unsplash.com/developers  (gratuit, 50 req/h)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Freesound — https://freesound.org/apiv2/apply/  (gratuit)
FREESOUND_API_KEY=your_freesound_api_key_here

# ── Chemins des données ──────────────────────────────────────────
AUDIO_DIR=data/raw_audio
CSV_FEATURES=data/audio_features.csv
CSV_LABELED=data/audio_features_labeled.csv

PICTURE_DIR=data/raw_picture
CSV_PICTURE_FEATURES=data/picture_features.csv
CSV_PICTURE_FEATURES_LABELED=data/picture_features_labeled.csv

# ── Paramètres audio ─────────────────────────────────────────────
BATCH_SIZE=10
TARGET_SR=22050
READ_SECONDS=30
