# API KEY ( data fetch )
# Unsplash - https://unsplash.com/developers  (free, 50 req/h)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Freesound - https://freesound.org/apiv2/apply/  (free) 
# Not used in the current version of the app, but can be used for future improvements
FREESOUND_API_KEY=your_freesound_api_key_here

# CORS - comma-separated list of allowed origins (defaults to localhost dev servers)
# CORS_ORIGINS=http://localhost:5173,http://localhost

# PATHS
AUDIO_DIR=data/raw_audio
CSV_FEATURES=data/audio_features.csv
CSV_LABELED=data/audio_features_labeled.csv

PICTURE_DIR=data/raw_picture
CSV_PICTURE_FEATURES=data/picture_features.csv
CSV_PICTURE_FEATURES_LABELED=data/picture_features_labeled.csv

# AUDIO PARAMETERS
BATCH_SIZE=10
TARGET_SR=22050
READ_SECONDS=30
